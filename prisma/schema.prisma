// use prisma-8

model PasswordEntry {
  id        String           @id @default(uuid())
  website   String
  url       String
  category  String
  username  String
  password  String
  favorite  Boolean          @default(false)
  createdAt TimestamptzString @default(now())
}

model GroceryItem {
  id        String           @id @default(uuid())
  dateKey   String
  name      String
  done      Boolean          @default(false)
  createdAt TimestamptzString @default(now())

  @@index([dateKey])
}

model BabyNeed {
  id        String           @id @default(uuid())
  dateKey   String
  title     String
  type      String
  notes     String           @default("")
  done      Boolean          @default(false)
  createdAt TimestamptzString @default(now())

  @@index([dateKey])
}

model PushSubscription {
  id        String           @id @default(uuid())
  endpoint  String           @unique
  p256dh    String
  auth      String
  createdAt TimestamptzString @default(now())
}

model MonthlyBudget {
  id         String           @id @default(uuid())
  monthKey   String           @unique
  amountCents Int
  createdAt  TimestamptzString @default(now())
}

model BudgetBill {
  id          String           @id @default(uuid())
  title       String
  category    String           @default("utility")
  amountCents Int
  frequency   String
  monthKey    String?
  dueDay      Int?
  paidMonthKeys String[]       @default([])
  createdAt   TimestamptzString @default(now())

  @@index([monthKey])
  @@index([frequency])
}

model AppSetting {
  id    String @id
  value String
}

model BabyProfile {
  id                String           @id @default(uuid())
  name              String
  birthDate         String
  gender            String           @default("unspecified")
  bloodType         String           @default("")
  birthWeight       String           @default("")
  birthHeight       String           @default("")
  pediatrician      String           @default("")
  pediatricianPhone String           @default("")
  allergies         String           @default("")
  notes             String           @default("")
  createdAt         TimestamptzString @default(now())
}

model BabyStoolLog {
  id          String           @id @default(uuid())
  loggedAt    TimestamptzString @default(now())
  type        String           @default("stool")
  consistency String           @default("soft")
  color       String           @default("yellow")
  amount      String           @default("medium")
  notes       String           @default("")
  createdAt   TimestamptzString @default(now())

  @@index([type])
}

model BabyVaccine {
  id             String           @id @default(uuid())
  vaccineName    String
  vaccineDate    String
  status         String           @default("upcoming")
  dose           String           @default("")
  administeredBy String           @default("")
  notes          String           @default("")
  createdAt      TimestamptzString @default(now())

  @@index([vaccineDate])
  @@index([status])
}

model BabyMedicine {
  id           String           @id @default(uuid())
  name         String
  dosage       String
  instructions String
  startDate    String
  endDate      String           @default("")
  frequency    String           @default("")
  status       String           @default("active")
  notes        String           @default("")
  createdAt    TimestamptzString @default(now())

  @@index([status])
}

model BabyGrowth {
  id                  String           @id @default(uuid())
  recordedDate        String
  monthAge            Int
  heightCm            Float
  weightKg            Float
  headCircumferenceCm Float?
  notes               String           @default("")
  createdAt           TimestamptzString @default(now())

  @@index([recordedDate])
  @@index([monthAge])
}

model BabyMedicalNote {
  id            String            @id @default(uuid())
  noteDate      String
  title         String            @default("")
  imageUrl      String            @default("")
  imagePathname String            @default("")
  imageSize     Int               @default(0)
  notes         String            @default("")
  doctorName    String            @default("")
  clinicName    String            @default("")
  category      String            @default("general")
  symptoms      String            @default("")
  doctorAdvice  String            @default("")
  createdAt     TimestamptzString @default(now())

  @@index([noteDate])
}

model BabySleepLog {
  id              String            @id @default(uuid())
  startTime       TimestamptzString @default(now())
  endTime         TimestamptzString?
  durationMinutes Int?
  sleepType       String            @default("night")
  status          String            @default("completed")
  notes           String            @default("")
  createdAt       TimestamptzString @default(now())

  @@index([startTime])
  @@index([status])
}

model BabyMilkLog {
  id          String            @id @default(uuid())
  loggedAt    TimestamptzString @default(now())
  preparedOz  Float
  status      String            @default("completed")
  leftoverOz  Float             @default(0)
  drankOz     Float
  milkType    String            @default("formula")
  notes       String            @default("")
  createdAt   TimestamptzString @default(now())

  @@index([loggedAt])
  @@index([status])
}

