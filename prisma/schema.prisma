// use prisma-8

model PasswordEntry {
  id        String           @id @default(uuid())
  website   String
  url       String
  category  String
  username  String
  password  String
  favorite  Boolean          @default(false)
  createdAt TimestamptzString @default(now())
}

model GroceryItem {
  id        String           @id @default(uuid())
  dateKey   String
  name      String
  done      Boolean          @default(false)
  createdAt TimestamptzString @default(now())

  @@index([dateKey])
}

model BabyNeed {
  id        String           @id @default(uuid())
  dateKey   String
  title     String
  type      String
  notes     String           @default("")
  done      Boolean          @default(false)
  createdAt TimestamptzString @default(now())

  @@index([dateKey])
}

model PushSubscription {
  id        String           @id @default(uuid())
  endpoint  String           @unique
  p256dh    String
  auth      String
  createdAt TimestamptzString @default(now())
}

model MonthlyBudget {
  id         String           @id @default(uuid())
  monthKey   String           @unique
  amountCents Int
  createdAt  TimestamptzString @default(now())
}

model BudgetBill {
  id          String           @id @default(uuid())
  title       String
  category    String           @default("utility")
  amountCents Int
  frequency   String
  monthKey    String?
  dueDay      Int?
  paidMonthKeys String[]       @default([])
  createdAt   TimestamptzString @default(now())

  @@index([monthKey])
  @@index([frequency])
}

model AppSetting {
  id    String @id
  value String
}
