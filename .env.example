# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Comma-separated 6-digit PINs allowed to sign in.
AUTH_PINS="123456,654321"
# Map each PIN to the profile name shown in the dashboard.
AUTH_USERS="123456:Alex Morgan,654321:Another User"
# Long random string used to sign session cookies (e.g. openssl rand -hex 32).
AUTH_SECRET="change-me"

# Push Notification
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your VAPID public key"
VAPID_PUBLIC_KEY="the same VAPID public key"
VAPID_PRIVATE_KEY="your VAPID private key"
VAPID_SUBJECT="mailto:you@example.com"
CRON_SECRET="a long random secret"
